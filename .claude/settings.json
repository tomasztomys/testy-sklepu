{
  "permissions": {
    "allow": [
      "Bash(npm run check)",
      "Bash(npx playwright test *)"
    ],
    "deny": [
      "Read(./.env)",
      "Read(./.env.*)",
      "Bash(git push *)"
    ]
  },
  "hooks": {
    "Stop": [
      {
        "hooks": [
          {
            "type": "command",
            "command": "npm run check 1>&2 || exit 2"
          }
        ]
      }
    ]
  }
}
